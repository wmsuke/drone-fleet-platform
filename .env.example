# PostgreSQL（Docker Compose内の接続先と初期化に使用）
# このファイルにはローカル開発専用のダミー値だけを記載すること。
# PostgreSQLのホスト名
POSTGRES_HOST=postgres
# PostgreSQLのTCPポート
POSTGRES_PORT=5432
# PostgreSQLのデータベース名
POSTGRES_DB=drone_fleet
# PostgreSQLのユーザー名
POSTGRES_USER=drone_fleet
# PostgreSQLのパスワード（ローカル開発専用のダミー値）
POSTGRES_PASSWORD=local-development-only

# MQTTブローカーのホスト名
MQTT_HOST=mosquitto
# MQTTブローカーのTCPポート
MQTT_PORT=1883

# シミュレータが起動する仮想ドローン数
DRONE_COUNT=10
