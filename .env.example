# PostgreSQL（Docker Compose内の接続先と初期化に使用）
# このファイルにはローカル開発専用のダミー値だけを記載すること。
# PostgreSQLのホスト名
POSTGRES_HOST=127.0.0.1
# PostgreSQLのTCPポート
POSTGRES_PORT=5432
# PostgreSQLのデータベース名
POSTGRES_DB=drone_fleet
# PostgreSQLのユーザー名
POSTGRES_USER=drone_fleet
# PostgreSQLのパスワード（ローカル開発専用のダミー値）
POSTGRES_PASSWORD=local-development-only

# シミュレータのMQTT transport（localまたはaws-iot）
MQTT_TRANSPORT=local
# ローカルMQTTブローカーのホスト名（ホストOSから起動する場合）
MQTT_HOST=127.0.0.1
# ローカルMQTTブローカーのTCPポート
MQTT_PORT=1883
# 負荷生成器の接続先（local または aws-iot）
LOAD_TRANSPORT=local
# 最終受信からオフラインと判定するまでの時間（ミリ秒）
OFFLINE_TIMEOUT_MS=15000

# telemetry-ingestorのDB書き込みバッチ
TELEMETRY_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL_MS=50
TELEMETRY_MAX_BUFFER_SIZE=10000

# telemetry-ingestorの負荷試験メトリクス（通常起動ではfalse）
LOAD_METRICS_ENABLED=false
# 計測を有効にするときの試験IDとingestorセッションID
LOAD_TEST_ID=local-load
LOAD_SESSION_ID=ingestor-1
# shutdown時に保存するJSONレポート
LOAD_METRICS_REPORT_PATH=load-results/local-load-ingestor-1-ingestor.json

# 負荷試験レポート集約（カンマ区切りで複数指定可）
LOAD_GENERATOR_REPORT_PATHS=load-results/local-load-worker-1.json
LOAD_INGESTOR_REPORT_PATHS=load-results/local-load-ingestor-1-ingestor.json
LOAD_AGGREGATE_REPORT_PATH=load-results/local-load-report.json

# HTTP APIの待受ホストとポート
API_HOST=127.0.0.1
API_PORT=3000
# APIがブラウザからのアクセスを許可するダッシュボードのorigin
DASHBOARD_ORIGIN=http://localhost:5173

# ダッシュボードが接続するHTTP APIのベースURL
VITE_API_BASE_URL=http://127.0.0.1:3000
# Docker Composeがホストへ公開するダッシュボードのポート
DASHBOARD_PORT=5173

# シミュレータが起動する仮想ドローンの台数（1〜1000の整数、既定値10）
DRONE_COUNT=10
# deviceIdの接頭辞（AWSではThing名と証明書directoryに合わせる）
DEVICE_ID_PREFIX=drone
# 状態系列を再現するシード（1〜128文字、未指定時default）
SIMULATION_SEED=default
# テレメトリの送信間隔（ミリ秒）
TELEMETRY_INTERVAL_MS=5000
# simulatorのSQLite永続バッファ（再起動後も保持するディレクトリ）
TELEMETRY_BUFFER_DIR=simulator-data
# 機体ごとの未確認telemetry上限（行数とJSONのUTF-8バイト数）
TELEMETRY_BUFFER_MAX_ROWS=10000
TELEMETRY_BUFFER_MAX_BYTES=33554432
# MQTT再接続・送信失敗時の指数バックオフ下限/上限と、蓄積分の最短送信間隔（ミリ秒）
TELEMETRY_RETRY_BASE_MS=1000
TELEMETRY_RETRY_MAX_MS=30000
TELEMETRY_REPLAY_INTERVAL_MS=200
# QoS 1のPUBACK待ち上限、およびPUBACK後のreceipt再試行の最小待機時間（ミリ秒）
TELEMETRY_PUBLISH_TIMEOUT_MS=10000

# AWS IoTデバイス証明書（実値はGit管理外の.envだけに設定する）
AWS_IOT_ENDPOINT=example-ats.iot.ap-northeast-1.amazonaws.com
AWS_IOT_ROOT_CA_PATH=secrets/aws-iot/AmazonRootCA1.pem
AWS_IOT_DEVICE_CREDENTIALS_DIR=secrets/aws-iot
# telemetry-ingestor専用のclientIdと認証情報（デバイス証明書と共有しない）
AWS_IOT_TELEMETRY_INGESTOR_CLIENT_ID=drone-fleet-dev-telemetry-ingestor
AWS_IOT_TELEMETRY_INGESTOR_CERTIFICATE_PATH=secrets/aws-iot/telemetry-ingestor/device.pem.crt
AWS_IOT_TELEMETRY_INGESTOR_PRIVATE_KEY_PATH=secrets/aws-iot/telemetry-ingestor/private.pem.key
# API専用のclientIdと認証情報（デバイス・telemetry-ingestor証明書と共有しない）
AWS_IOT_API_CLIENT_ID=drone-fleet-dev-api
AWS_IOT_API_CERTIFICATE_PATH=secrets/aws-iot/api/device.pem.crt
AWS_IOT_API_PRIVATE_KEY_PATH=secrets/aws-iot/api/private.pem.key

# AWS IoT負荷確認。AWS実行時だけ.envへ実値を設定する
AWS_IOT_PORT=8883
AWS_IOT_RULE_NAME=drone_fleet_load_test
# Billingで対象期間と残量を確認した場合だけtrueにする
AWS_IOT_FREE_TIER_CONFIRMED=false
# 当月にこのプロジェクトで使用済みのBasic Ingest件数
AWS_IOT_MONTH_TO_DATE_MESSAGES=0
# 経路確認専用probe。load deviceの証明書とは共有しない
AWS_IOT_PROBE_CERTIFICATE_PATH=secrets/aws-iot/load-probe/device.pem.crt
AWS_IOT_PROBE_PRIVATE_KEY_PATH=secrets/aws-iot/load-probe/private.pem.key
