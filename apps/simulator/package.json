{
  "name": "@drone-fleet/simulator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./src/simulator.ts",
      "development": "./src/simulator.ts",
      "import": "./dist/simulator.js"
    },
    "./transport": {
      "types": "./src/mqtt-transport.ts",
      "development": "./src/mqtt-transport.ts",
      "import": "./dist/mqtt-transport.js"
    },
    "./config": {
      "types": "./src/config.ts",
      "development": "./src/config.ts",
      "import": "./dist/config.js"
    }
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@drone-fleet/config": "workspace:*",
    "@types/node": "^26.6.3",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@drone-fleet/protocol": "workspace:*",
    "mqtt": "^5.16.0"
  }
}
