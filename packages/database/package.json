{
  "name": "@drone-fleet/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "db:migrate": "pnpm build && node --env-file-if-exists=../../.env dist/migrate.js",
    "test:integration": "vitest run test/database.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@drone-fleet/config": "workspace:*",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  }
}
