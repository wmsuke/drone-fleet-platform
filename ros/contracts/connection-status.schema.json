{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 1 },
    "deviceId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "payload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": { "type": "string", "const": "ONLINE" },
            "reason": { "type": "string", "const": "CONNECTED" }
          },
          "required": ["status", "reason"]
        },
        {
          "type": "object",
          "properties": {
            "status": { "type": "string", "const": "OFFLINE" },
            "reason": {
              "type": "string",
              "enum": ["SHUTDOWN", "CONNECTION_LOST"]
            }
          },
          "required": ["status", "reason"]
        }
      ]
    }
  },
  "required": ["schemaVersion", "deviceId", "timestamp", "payload"]
}
