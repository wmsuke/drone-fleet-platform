# localの例。実際のdeviceと永続volumeを指定する。
BRIDGE_DEVICE_ID=ros-ref-001
BRIDGE_STATE_DIR=/data/fleet
MQTT_TRANSPORT=local
MQTT_HOST=mqtt
MQTT_PORT=1883
ROS_DOMAIN_ID=42
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
ROS_STATIC_PEERS=
BRIDGE_QUEUE_LIMIT=100
BRIDGE_RECORD_LIMIT=10000
BRIDGE_BYTE_LIMIT=33554432
BRIDGE_RECONNECT_MIN_SEC=1
BRIDGE_RECONNECT_MAX_SEC=8
# AWSではlocalのMQTT_HOST/MQTT_PORTを削除し、次を指定する。
# MQTT_TRANSPORT=aws-iot
# AWS_IOT_ENDPOINT=example-ats.iot.ap-southeast-2.amazonaws.com
# AWS_IOT_ROOT_CA_PATH=/run/secrets/iot/AmazonRootCA1.pem
# AWS_IOT_DEVICE_CREDENTIALS_DIR=/run/secrets/iot/devices
# devices/<deviceId>/device.pem.crt と private.pem.key をread-only mountする。
